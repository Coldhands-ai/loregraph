@startuml seq-relations
title Управление связями между статьями

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 200
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #000000
    FontSize 13
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontColor #000000
    FontSize 12
}
skinparam sequence {
    LifeLineBorderColor #BBBBBB
    DividerBackgroundColor #F3F4F6
    DividerBorderColor #CCCCCC
    DividerFontColor #555555
    DividerFontSize 11
}

participant "Пользователь" as U
participant "Браузер\n(сайдбар «Связи»)" as FE
participant "Flask\nblueprint articles" as APP
participant "PostgreSQL" as DB

== Просмотр связей статьи ==

U -> FE : Открывает /worlds/<id>/articles/<aid>
FE -> APP : GET .../articles/<aid>
APP -> APP : @login_required + проверка владения
APP -> DB : SELECT relations WHERE\n  source_article_id = ? OR target_article_id = ?\nс JOIN-связанными статьями (source, target)
DB --> APP : { relations[] с двумя концами }
APP --> FE : render_template('articles/edit.html', relations=...)
FE --> U : Сайдбар:\n→ Цири (отец)\n→ Йеннифэр (любовники)\n→ Каэр Морхен (живёт в)

== Добавление связи ==

U -> FE : Нажимает «+ Добавить связь»\n(форма уже на странице)
U -> FE : Печатает «Ци...» в поле поиска статьи
FE -> APP : GET /worlds/<id>/articles/search.json?q=Ци
APP -> DB : SELECT id, title FROM articles\nWHERE world_id = ? AND title ILIKE '%Ци%'\nLIMIT 8
DB --> APP : [{ id, title }, ...]
APP --> FE : { results: [...] }
FE --> U : Выпадающий список совпадений
U -> FE : Кликает на «Цири» → выбирает label (или пишет свой)
U -> FE : Submit формы
FE -> APP : POST .../articles/<aid>/relations\n(target_article_id, label, csrf_token)
APP -> APP : RelationForm.validate_on_submit()
APP -> APP : Проверки: target.world_id == world_id,\nsource != target
APP -> DB : INSERT INTO relations\n(world_id, source_article_id,\n target_article_id, label)
note right of DB
  CHECK source != target
  UNIQUE (source, target, label)
  → если нарушение — IntegrityError
end note
DB --> APP : OK или 23505 (дубликат)
alt успех
    APP --> FE : 302 → редактор (со свежим списком связей)
else дубликат
    APP -> APP : flash «Такая связь уже существует»
    APP --> FE : 302 → редактор
end

== Удаление связи ==

U -> FE : Кликает ✕ рядом со связью
FE --> U : confirm() — подтвердить?
U -> FE : Подтверждает
FE -> APP : POST .../relations/<rid>/delete (csrf)
APP -> APP : Проверка владения миром
APP -> DB : DELETE FROM relations WHERE id = ?
DB --> APP : OK
APP --> FE : 302 → редактор (без удалённой связи)

@enduml
