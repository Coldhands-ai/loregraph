@startuml seq-graph
title Визуализация графа связей

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 200
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #000000
    FontSize 13
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontColor #000000
    FontSize 12
}
skinparam sequence {
    LifeLineBorderColor #BBBBBB
    DividerBackgroundColor #F3F4F6
    DividerBorderColor #CCCCCC
    DividerFontColor #555555
    DividerFontSize 11
}

participant "Пользователь" as U
participant "Браузер\n(Cytoscape.js)" as FE
participant "graph.js" as JS
participant "Flask\nblueprint graph" as APP
participant "PostgreSQL" as DB

== Загрузка графа ==

U -> FE : Открывает /worlds/<id>/graph
FE -> APP : GET .../graph
APP --> FE : render_template('graph/view.html')\n(пустой контейнер #cy + фильтры по категориям)
FE -> JS : DOMContentLoaded → graph.js
JS -> APP : fetch /worlds/<id>/graph/data.json
APP -> APP : @login_required + проверка владения
APP -> DB : SELECT articles WHERE world_id = ?
DB --> APP : { articles[] }
APP -> DB : SELECT relations WHERE world_id = ?
DB --> APP : { relations[] }
APP -> APP : Маппинг в формат Cytoscape:\n{ nodes: [{data:{id,label,initial,color,size,...}}],\n  edges: [{data:{id,source,target,label,source_color,target_color}}]}
APP --> JS : JSON
JS -> FE : cytoscape({ elements, style, layout: 'cose' })
note right of FE
  Стилизация:
  - размер узла = data(size) (зависит от веса категории)
  - буква в центре узла = data(initial)
  - цвет ребра = data(source_color)
  - бегущая пунктирная анимация
    (setInterval line-dash-offset)
end note
FE --> U : Граф нарисован, force-layout раскладывает узлы

== Hover на узле — превью ==

U -> JS : Наводит курсор на узел «Геральт»
JS -> JS : cy.on('mouseover', 'node'):\n- closedNeighborhood().removeClass('faded')\n- остальные узлы и рёбра .addClass('faded')\n- node.addClass('hovered')
JS -> FE : Показывает HTML-tooltip:\nкатегория, обложка, summary
FE --> U : Связанные подсвечены, остальные тускнеют, рядом всплывает карточка

== Клик на узле — превью в боковой панели ==

U -> JS : Клик по узлу
JS -> JS : cy.on('tap', 'node') → renderPreview(node)
JS -> FE : Заполняет sticky-панель справа:\nобложка, категория, название, summary, кнопка «Открыть статью →»
FE --> U : Превью статьи без перехода

== Поиск и фокусировка ==

U -> FE : Печатает «Цири» в поле поиска
FE -> JS : input event (debounce 200мс)
JS -> JS : cy.nodes().find(label.includes(q))
JS -> FE : cy.animate({ center: node, zoom: 1.6 })\nnode.flashClass('focused', 1500)
FE --> U : Камера летит к узлу, ободок мигает

== Двойной клик — переход в статью ==

U -> JS : Двойной клик по узлу
JS -> FE : window.location = '/worlds/<id>/articles/<aid>'
FE --> U : Открывается редактор статьи

@enduml
