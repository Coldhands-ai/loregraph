@startuml seq-registration
title Регистрация пользователя

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 200
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #000000
    FontSize 13
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontColor #000000
    FontSize 12
}
skinparam sequence {
    LifeLineBorderColor #BBBBBB
    DividerBackgroundColor #F3F4F6
    DividerBorderColor #CCCCCC
    DividerFontColor #555555
    DividerFontSize 11
}

participant "Пользователь" as U
participant "Браузер\n(Jinja-страница)" as FE
participant "Flask\nblueprint auth" as APP
participant "PostgreSQL\n(Docker)" as DB
participant "Google OAuth" as GOOG

== Регистрация по email/паролю ==

U -> FE : Открывает /auth/register, заполняет форму\n(имя, email, пароль x2)
FE -> APP : POST /auth/register\n+ csrf_token, RegisterForm
APP -> APP : WTForms.validate_on_submit()\n(email-формат, пароль ≥6, пароли совпадают)
APP -> DB : SELECT * FROM users WHERE email = ?
DB --> APP : null (email свободен)
APP -> APP : bcrypt.hashpw(password)
APP -> DB : INSERT INTO users (id, email, display_name, password_hash, role)\nVALUES (uuid(), ?, ?, ?, 'user')
DB --> APP : OK
APP -> APP : Flask-Login: login_user(user)\n(сессионная cookie)
APP --> FE : 302 Redirect → /worlds
FE --> U : Открывается страница «Мои миры»\n(пустое состояние с CTA)

== OAuth через Google ==

U -> FE : Кнопка «Войти через Google» (GET /auth/google)
FE -> APP : GET /auth/google
APP -> APP : Authlib: oauth.google.authorize_redirect(callback_url)
APP --> U : 302 Redirect → accounts.google.com
U -> GOOG : Подтверждает доступ
GOOG --> APP : 302 Redirect → /auth/google/callback?code=...
APP -> GOOG : Authlib: authorize_access_token() → userinfo
GOOG --> APP : { sub, email, name, picture }
APP -> DB : SELECT * FROM users WHERE google_sub = ? OR email = ?
alt пользователь существует
    DB --> APP : { user }
    APP -> DB : UPDATE last_sign_in
else новый пользователь
    DB --> APP : null
    APP -> DB : INSERT INTO users\n(google_sub, email, display_name, avatar_url)
end
APP -> APP : Flask-Login: login_user(user, remember=true)
APP --> FE : 302 Redirect → /worlds
FE --> U : Вход выполнен

@enduml
