@startuml seq-article
title Создание и редактирование статьи

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 200
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #000000
    FontSize 13
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontColor #000000
    FontSize 12
}
skinparam sequence {
    LifeLineBorderColor #BBBBBB
    DividerBackgroundColor #F3F4F6
    DividerBorderColor #CCCCCC
    DividerFontColor #555555
    DividerFontSize 11
}

participant "Пользователь" as U
participant "Браузер\n(Toast UI Editor)" as FE
participant "Flask\nblueprint articles" as APP
participant "PostgreSQL" as DB
participant "static/uploads/\n(локальный диск)" as DISK

== Создание статьи ==

U -> FE : Кнопка «+ Новая статья» в /worlds/<id>/articles
FE --> U : Модалка (Alpine.js): название + категория
U -> FE : Заполняет, отправляет
FE -> APP : POST /worlds/<id>/articles/create\n(title, category_id, csrf_token)
APP -> APP : @login_required + проверка владения миром
APP -> DB : INSERT INTO articles\n(world_id, title, category_id, content_md='')
DB --> APP : { article_id }
APP --> FE : 302 → /worlds/<id>/articles/<aid>
FE -> APP : GET /worlds/<id>/articles/<aid>
APP -> DB : SELECT article, categories\n+ список связей
DB --> APP : данные
APP --> FE : render_template('articles/edit.html')
note right of FE
  В шаблоне:
  - Toast UI Editor (CDN, dark theme)
  - блок template_fields из категории
  - сайдбар связей
end note
FE --> U : Редактор открыт

== Автосейв при наборе ==

U -> FE : Печатает в Toast UI Editor (WYSIWYG-режим)
FE -> FE : event 'change' → debounce(2с)\n→ editor.getMarkdown()
FE -> APP : POST /worlds/<id>/articles/<aid>/autosave\n(JSON: { content_md, csrf })
APP -> APP : Проверка владения, валидация
APP -> APP : autosummary = bleach.strip(markdown.markdown(...))[:200]
APP -> DB : UPDATE articles SET content_md, summary, updated_at = now()
DB --> APP : OK
APP --> FE : 200 OK { ok: true, updated_at }
FE --> U : Индикатор «Сохранено»

== Заполнение полей шаблона (template_fields) ==

U -> FE : Печатает в поле «Раса» категории «Персонаж»
FE -> FE : input event → debounce(2с)\n→ собирает все поля в { key: value }
FE -> APP : POST .../autosave\n(JSON: { field_values: {...} })
APP -> APP : Принимает только ключи из текущей category.template_fields
APP -> DB : UPDATE articles SET field_values = ?
DB --> APP : OK
APP --> FE : 200 OK

== Загрузка обложки ==

U -> FE : Hover на блок обложки → «Загрузить обложку» (input type=file)
FE -> APP : POST .../cover (multipart/form-data, csrf)
APP -> APP : CoverUploadForm: FileAllowed, FileSize ≤5МБ
APP -> APP : storage.save_image():\n- расширение в whitelist\n- Pillow.verify() — реально картинка
APP -> DISK : Сохранить в static/uploads/articles/<aid>/<random>.ext
DISK --> APP : OK
APP -> APP : Старая обложка → storage.delete_image() с диска
APP -> DB : UPDATE articles SET image_url = '/static/uploads/...'
DB --> APP : OK
APP --> FE : 302 → редактор статьи (с обновлённой обложкой)

@enduml