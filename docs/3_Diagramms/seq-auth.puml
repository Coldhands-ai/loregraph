@startuml seq-auth
title Авторизация и защита маршрутов (Flask edition)

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam maxmessagesize 200
skinparam sequenceParticipant underline

skinparam participant {
    BackgroundColor #EFF6FF
    BorderColor #3B82F6
    FontColor #000000
    FontSize 13
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontColor #000000
    FontSize 12
}
skinparam sequence {
    LifeLineBorderColor #BBBBBB
    DividerBackgroundColor #F3F4F6
    DividerBorderColor #CCCCCC
    DividerFontColor #555555
    DividerFontSize 11
}

participant "Пользователь" as U
participant "Браузер" as FE
participant "Flask\nblueprint auth" as AUTH
participant "Flask-Login\n(session cookie)" as LOGIN
participant "PostgreSQL" as DB

== Вход ==

U -> FE : POST /auth/login\n(email, password, csrf_token)
FE -> AUTH : Запрос
AUTH -> AUTH : LoginForm.validate_on_submit()
AUTH -> DB : SELECT * FROM users WHERE email = ?
DB --> AUTH : { user, password_hash }
AUTH -> AUTH : bcrypt.checkpw(password, hash)
AUTH -> AUTH : Проверка is_blocked
AUTH -> LOGIN : login_user(user, remember=?)
LOGIN -> AUTH : Set-Cookie: session=<signed>
AUTH -> DB : UPDATE last_sign_in
AUTH --> FE : 302 → /worlds
FE --> U : Перенаправление, ✅ flash «С возвращением»

== Запрос к защищённым данным ==

U -> FE : Открывает /worlds (cookie session=...)
FE -> AUTH : GET /worlds (с cookie)
AUTH -> LOGIN : @login_required → load_user(session.user_id)
LOGIN -> DB : SELECT * FROM users WHERE id = ?
DB --> LOGIN : { user }
LOGIN --> AUTH : current_user заполнен
AUTH -> DB : SELECT * FROM worlds WHERE user_id = current_user.id
DB --> AUTH : { worlds[] }
AUTH --> FE : render_template('worlds/list.html', worlds=...)
FE --> U : HTML со списком миров

== Защита маршрутов (незалогиненный) ==

U -> FE : GET /worlds  (cookie отсутствует)
FE -> AUTH : Запрос
AUTH -> LOGIN : @login_required → нет сессии
LOGIN --> AUTH : flash «Войди, чтобы продолжить»
AUTH --> FE : 302 → /auth/login?next=/worlds
FE --> U : Открывается страница входа

== Защита админ-маршрутов ==

U -> FE : GET /admin (cookie есть, но role = 'user')
FE -> AUTH : Запрос
AUTH -> LOGIN : @login_required → ОК, current_user заполнен
note right of AUTH
  blueprint admin имеет
  before_request:
  if not current_user.is_admin:
      abort(403)
end note
AUTH --> FE : 403 errors/403.html
FE --> U : «Сюда нельзя» + ссылка на /worlds

@enduml