// ============================================================
// LoreGraph — ERD (Entity Relationship Diagram)
// Конструктор интерактивных вики с графом связей
// Database: PostgreSQL (Supabase)
// Format: DBML (dbdiagram.io)
// ============================================================

// ─────────────────────────────────────────────
// 1. ПОЛЬЗОВАТЕЛИ
// ─────────────────────────────────────────────

Table profiles {
  id uuid [pk, note: 'FK → auth.users.id, создаётся триггером при регистрации']
  email text [not null, unique, note: 'Email пользователя (копия из auth.users)']
  display_name text [note: 'Отображаемое имя']
  avatar_url text [note: 'URL аватара в Supabase Storage']
  role text [not null, default: 'user', note: 'Роль: user | admin']
  is_blocked boolean [not null, default: false, note: 'Флаг блокировки (управляется админом)']
  created_at timestamptz [not null, default: `now()`, note: 'Дата регистрации']
  last_sign_in timestamptz [note: 'Последний вход в систему']

  note: 'Профили пользователей. Создаются автоматически через database trigger при регистрации в Supabase Auth. RLS: пользователь видит только свой профиль, админ — все.'
}

// ─────────────────────────────────────────────
// 2. ПРОЕКТЫ (МИРЫ)
// ─────────────────────────────────────────────

Table projects {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > profiles.id, note: 'Владелец мира']
  title text [not null, note: 'Название мира (макс. 100 символов)']
  description text [note: 'Краткое описание мира']
  cover_url text [note: 'URL обложки в Supabase Storage']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Обновляется триггером при изменении']

  note: 'Миры (проекты). Каждый пользователь может создать несколько миров. При создании мира автоматически создаются 5 предустановленных категорий. RLS: user_id = auth.uid().'

  indexes {
    user_id [name: 'idx_projects_user_id']
    created_at [name: 'idx_projects_created_at']
  }
}

// ─────────────────────────────────────────────
// 3. КАТЕГОРИИ
// ─────────────────────────────────────────────

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'Мир, к которому относится']
  name text [not null, note: 'Название категории (Персонаж, Локация, Событие...)']
  color text [not null, default: '#3B82F6', note: 'HEX-цвет для отображения на графе и в UI']
  icon text [note: 'Имя иконки из набора Lucide (например, "sword", "map-pin")']
  sort_order int [not null, default: 0, note: 'Порядок отображения в списке']
  created_at timestamptz [not null, default: `now()`]

  note: 'Категории сущностей внутри мира. Предустановленные при создании мира: Персонаж (#3B82F6), Локация (#10B981), Событие (#F59E0B), Предмет (#EF4444), Фракция (#8B5CF6). Пользователь может добавлять свои.'

  indexes {
    project_id [name: 'idx_categories_project_id']
    (project_id, name) [unique, name: 'uq_categories_project_name']
  }
}

// ─────────────────────────────────────────────
// 4. СТАТЬИ
// ─────────────────────────────────────────────

Table articles {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'Мир']
  category_id uuid [ref: > categories.id, note: 'Категория статьи (может быть NULL — без категории)']
  title text [not null, note: 'Название статьи (макс. 200 символов)']
  content jsonb [default: '{}', note: 'Контент статьи в формате TipTap JSON']
  summary text [note: 'Краткое описание (первые 200 символов текста, для превью)']
  image_url text [note: 'URL обложки статьи в Supabase Storage']
  is_pinned boolean [not null, default: false, note: 'Закреплённая статья (отображается первой)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Обновляется при каждом автосохранении']

  note: 'Статьи (сущности мира). Хранят контент в формате TipTap JSON, что позволяет рендерить форматирование на клиенте. Автосохранение с debounce 2 секунды. RLS: доступ через project → user_id.'

  indexes {
    project_id [name: 'idx_articles_project_id']
    category_id [name: 'idx_articles_category_id']
    updated_at [name: 'idx_articles_updated_at']
    (project_id, title) [name: 'idx_articles_project_title']
  }
}

// ─────────────────────────────────────────────
// 5. СВЯЗИ МЕЖДУ СТАТЬЯМИ
// ─────────────────────────────────────────────

Table relations {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'Мир (для RLS и фильтрации)']
  source_article_id uuid [not null, ref: > articles.id, note: 'Статья-источник']
  target_article_id uuid [not null, ref: > articles.id, note: 'Статья-цель']
  label text [not null, note: 'Тип связи: "друг", "владеет", "находится в", "участвовал в"...']
  description text [note: 'Дополнительное описание связи (опционально)']
  created_at timestamptz [not null, default: `now()`]

  note: 'Именованные связи между статьями. Отображаются как рёбра на графе. Связь является направленной (source → target), но на графе показывается двусторонне. Запрещено создавать связь статьи с самой собой.'

  indexes {
    project_id [name: 'idx_relations_project_id']
    source_article_id [name: 'idx_relations_source']
    target_article_id [name: 'idx_relations_target']
    (source_article_id, target_article_id, label) [unique, name: 'uq_relations_source_target_label']
  }
}

// ─────────────────────────────────────────────
// 6. ТЕГИ
// ─────────────────────────────────────────────

Table tags {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'Мир']
  name text [not null, note: 'Название тега (напр. "ключевой персонаж", "столица", "главный квест")']
  created_at timestamptz [not null, default: `now()`]

  note: 'Теги для статей. Создаются пользователем и привязываются к конкретному миру. Один тег может быть назначен нескольким статьям.'

  indexes {
    project_id [name: 'idx_tags_project_id']
    (project_id, name) [unique, name: 'uq_tags_project_name']
  }
}

// ─────────────────────────────────────────────
// 7. СВЯЗЬ СТАТЕЙ И ТЕГОВ (M2M)
// ─────────────────────────────────────────────

Table article_tags {
  article_id uuid [not null, ref: > articles.id, note: 'Статья']
  tag_id uuid [not null, ref: > tags.id, note: 'Тег']

  note: 'Связующая таблица многие-ко-многим между статьями и тегами.'

  indexes {
    (article_id, tag_id) [pk, name: 'pk_article_tags']
    tag_id [name: 'idx_article_tags_tag_id']
  }
}

// ─────────────────────────────────────────────
// 8. ТИПЫ СВЯЗЕЙ (ПРЕДУСТАНОВЛЕННЫЕ)
// ─────────────────────────────────────────────

Table relation_types {
  id uuid [pk, default: `gen_random_uuid()`]
  project_id uuid [not null, ref: > projects.id, note: 'Мир']
  name text [not null, note: 'Название типа связи: "друг", "враг", "владеет", "находится в"...']
  color text [note: 'Цвет рёбра на графе (HEX)']
  is_directional boolean [not null, default: true, note: 'Направленная связь (A → B) или ненаправленная (A ↔ B)']

  note: 'Справочник типов связей. Предустановленные при создании мира + пользователь может добавлять свои. Используется для подсказки при создании связи.'

  indexes {
    project_id [name: 'idx_relation_types_project_id']
    (project_id, name) [unique, name: 'uq_relation_types_project_name']
  }
}

// ─────────────────────────────────────────────
// 9. ИСТОРИЯ ИЗМЕНЕНИЙ СТАТЕЙ (ВЕРСИОНИРОВАНИЕ)
// ─────────────────────────────────────────────

Table article_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  article_id uuid [not null, ref: > articles.id, note: 'Статья']
  version_number int [not null, note: 'Номер версии (1, 2, 3...)']
  title text [not null, note: 'Название на момент сохранения']
  content jsonb [not null, note: 'Контент на момент сохранения (TipTap JSON)']
  created_at timestamptz [not null, default: `now()`, note: 'Дата создания версии']

  note: 'История изменений статей. Новая версия создаётся при каждом значительном сохранении (не при каждом автосохранении, а например раз в 10 минут или при ручном сохранении). Позволяет откатиться к предыдущей версии.'

  indexes {
    article_id [name: 'idx_article_versions_article_id']
    (article_id, version_number) [unique, name: 'uq_article_versions_number']
  }
}

// ─────────────────────────────────────────────
// 10. ЛОГ ДЕЙСТВИЙ АДМИНИСТРАТОРА
// ─────────────────────────────────────────────

Table admin_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  admin_id uuid [not null, ref: > profiles.id, note: 'Админ, совершивший действие']
  action text [not null, note: 'Тип действия: block_user, unblock_user, delete_project, change_role...']
  target_user_id uuid [ref: > profiles.id, note: 'Целевой пользователь (если применимо)']
  target_project_id uuid [ref: > projects.id, note: 'Целевой проект (если применимо)']
  details jsonb [note: 'Дополнительные данные (причина блокировки, старое/новое значение)']
  created_at timestamptz [not null, default: `now()`]

  note: 'Журнал действий администратора. Записывает все административные операции для аудита. Только для чтения (записи не удаляются).'

  indexes {
    admin_id [name: 'idx_admin_logs_admin_id']
    created_at [name: 'idx_admin_logs_created_at']
    action [name: 'idx_admin_logs_action']
  }
}

// ─────────────────────────────────────────────
// 11. ИЗБРАННЫЕ СТАТЬИ (ЗАКЛАДКИ)
// ─────────────────────────────────────────────

Table bookmarks {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > profiles.id, note: 'Пользователь']
  article_id uuid [not null, ref: > articles.id, note: 'Статья']
  created_at timestamptz [not null, default: `now()`]

  note: 'Закладки пользователя на статьи. Быстрый доступ к часто используемым статьям.'

  indexes {
    (user_id, article_id) [unique, name: 'uq_bookmarks_user_article']
    user_id [name: 'idx_bookmarks_user_id']
  }
}
