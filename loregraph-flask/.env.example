# Flask
FLASK_SECRET_KEY=замени-на-длинную-случайную-строку
FLASK_DEBUG=1

# PostgreSQL (соответствует docker-compose.yml)
DATABASE_URL=postgresql+psycopg://loregraph:loregraph_dev@localhost:5432/loregraph

# Google OAuth (опционально). Получить на https://console.cloud.google.com/
# В авторизованных redirect URI у того же OAuth-клиента добавить:
#   http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
